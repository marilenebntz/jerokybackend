# Database Configuration (PostgreSQL)
# Note: When deploying with Dokploy Managed Postgres, use the internal container hostname / IP provided by Dokploy
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu_contrasena_segura_de_produccion
DATABASE_NAME=jeroky_soft_db

# TypeORM Migration & Synchronization
# Automatic migrations execution on container start
DATABASE_MIGRATIONS_RUN=true
DATABASE_SYNCHRONIZE=false

# JWT & Security
JWT_SECRET=generar_clave_super_segura_jwt_para_produccion
JWT_EXPIRATION=1d
ENCRYPTION_KEY=clave_de_encriptacion_exactamente_de_32_bytes!

# AWS Rekognition (Face ID Biometrics)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_aws_access_key_id
AWS_SECRET_ACCESS_KEY=tu_aws_secret_access_key
AWS_REKOGNITION_COLLECTION_ID=jeroky-faces-collection-prod

# Brevo (Sendinblue) Transactional Email
BREVO_API_KEY=xkeysib-tu-api-key-v3
BREVO_SENDER_EMAIL=notificaciones@tu-dominio.com
BREVO_SENDER_NAME="Centro de Danzas Jeroky Paraguai"

# Application Settings
NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://jerokysoft.site,https://www.jerokysoft.site

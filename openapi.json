  "info": {
    "title": "Yeruti Academia de Danza API",
    "description": "API documentation for the Yeruti Dance Academy management system",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter your JWT token to access secured endpoints",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "passwordHash": {
            "type": "string"
          },
          "role": {
            "enum": [
              "Administrator",
              "Director",
              "Docente",
              "Operador",
              "Alumno",
              "Tutor"
            ],
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "passwordHash",
          "role",
          "isActive",
          "firstName",
          "lastName",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateTutorDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$"
          },
          "lastName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$"
          },
          "ci": {
            "type": "string",
            "pattern": "^\\d{6,15}$"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\d{6,13}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "ci",
          "phone",
          "email"
        ]
      },
      "CreateStudentDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$"
          },
          "lastName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+$"
          },
          "ci": {
            "type": "string",
            "pattern": "^\\d{6,15}$"
          },
          "birthDate": {
            "type": "string"
          },
          "encryptedMedicalInfo": {
            "type": "string"
          },
          "biometricConsent": {
            "type": "boolean"
          },
          "tutorId": {
            "type": "string"
          },
          "tutor": {
            "$ref": "#/components/schemas/CreateTutorDto"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "ci",
          "birthDate"
        ]
      },
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "ci": {
            "type": "string"
          },
          "birthDate": {
            "format": "date-time",
            "type": "string"
          },
          "encryptedMedicalInfo": {
            "type": "string",
            "nullable": true
          },
          "biometricTemplateId": {
            "type": "string",
            "nullable": true
          },
          "biometricConsent": {
            "type": "boolean"
          },
          "tutor": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Tutor"
              }
            ]
          },
          "user": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "ci",
          "birthDate",
          "encryptedMedicalInfo",
          "biometricTemplateId",
          "biometricConsent",
          "tutor",
          "user",
          "createdAt",
          "updatedAt"
        ]
      },
      "Tutor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "ci": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "ci",
          "phone",
          "email",
          "students",
          "createdAt",
          "updatedAt"
        ]
      },
      "EnrollStudentDto": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "format": "uuid"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "studentId",
          "courseId"
        ]
      },
      "CourseSchedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "courseId": {
            "type": "string"
          },
          "dayOfWeek": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
